#!/usr/bin/env bash
set -euo pipefail

# murale-supervisor — dual-process overlap lifecycle manager
# Launches murale, periodically spins up a fresh instance with overlap,
# promotes new instance after compositor-acknowledged readiness, retires old.

# --- Configuration ---
MURALE_BIN="${MURALE_BIN:-murale}"
REFRESH_INTERVAL="${MURALE_REFRESH_INTERVAL:-7200}"
OVERLAP_TIMEOUT=15
HEALTH_WINDOW=10
MAX_CONSECUTIVE_FAILURES=3
DEFAULT_CALIBRATION_OFFSET="1.400"
HOLDOUT_THRESHOLD="0.200"
POS_TOLERANCE_FRAMES="${POS_TOLERANCE_FRAMES:-1.5}"
python3 -c 'import sys,math;v=float(sys.argv[1]);assert math.isfinite(v) and 0.5<=v<=10' "$POS_TOLERANCE_FRAMES" 2>/dev/null \
    || { echo "ERROR: invalid POS_TOLERANCE_FRAMES=$POS_TOLERANCE_FRAMES (need finite number in [0.5,10])" >&2; exit 1; }

# --- Argument parsing: VIDEO is first positional, rest pass through ---
if [[ $# -lt 1 ]]; then
    echo "Usage: murale-supervisor VIDEO [MURALE_OPTIONS...] [--mpv-options OPTIONS]" >&2
    exit 1
fi

DEFAULT_VIDEO="$1"; shift

USER_MPV_OPTS=""
MURALE_PASSTHROUGH=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --mpv-options=*) USER_MPV_OPTS="${1#--mpv-options=}"; shift ;;
        --mpv-options)   USER_MPV_OPTS="${2:-}"; shift 2 ;;
        *)               MURALE_PASSTHROUGH+=("$1"); shift ;;
    esac
done

# Check if workspace args were provided
HAS_WORKSPACE=false
for arg in "${MURALE_PASSTHROUGH[@]+"${MURALE_PASSTHROUGH[@]}"}"; do
    case "$arg" in
        --workspace|--workspace=*|-w) HAS_WORKSPACE=true ;;
    esac
done

# --- Environment validation (critic #3: validate inside supervisor, not ExecStartPre) ---
: "${WAYLAND_DISPLAY:?WAYLAND_DISPLAY must be set}"
: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR must be set}"

if $HAS_WORKSPACE && [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    echo "ERROR: --workspace requires HYPRLAND_INSTANCE_SIGNATURE" >&2
    exit 1
fi

if [[ ! -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]]; then
    echo "ERROR: Wayland socket not found: ${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" >&2
    exit 1
fi

if [[ ! -x "$MURALE_BIN" ]]; then
    echo "ERROR: murale binary not found or not executable: $MURALE_BIN" >&2
    exit 1
fi

# --- Paths ---
READY_DIR="${XDG_RUNTIME_DIR}/murale"
mkdir -p "$READY_DIR"
chmod 700 "$READY_DIR"
LOG_DIR="$READY_DIR/logs"
mkdir -p "$LOG_DIR" "$LOG_DIR/failed"
CAL_FILE="$READY_DIR/calibration.json"

# Singleton lock — prevent concurrent supervisors
exec 9>"$READY_DIR/supervisor.lock"
if ! flock -n 9; then
    echo "ERROR: another murale-supervisor is running (lock held)" >&2
    exit 1
fi

# Supervisor stderr → log file
exec 2>>"$LOG_DIR/supervisor.log"

# --- State ---
CURRENT_PID=""
CURRENT_SLOT=0
CURRENT_READY_FILE=""
CURRENT_GEN_TOKEN=""
CURRENT_RELEASE_TARGET_FILE=""
NEXT_PID=""
NEXT_READY_FILE=""
NEXT_GEN_TOKEN=""
NEXT_RELEASE_TARGET_FILE=""
GENERATION=0
CONSECUTIVE_FAILURES=0
TIMER_PID=""
CLEANED=false

log() { printf '[murale-sup] %s %s\n' "$(date '+%H:%M:%S')" "$*" >&2; }

sock_path() { printf '%s/sock-%s' "$READY_DIR" "$1"; }

# --- Signal file cleanup: remove all artifacts for a generation (Item 5) ---
cleanup_gen() {
    local gen_token="$1"
    [[ -z "$gen_token" ]] && return
    rm -f "$READY_DIR"/{ready,hold-ready,swap-done,target-rendered,arm-render,release-target}-"$gen_token"
}

# --- Mark a generation as failed: cleanup signals + move log (Items 1,5) ---
fail_gen() {
    local gen_token="$1"
    cleanup_gen "$gen_token"
    [[ -f "$LOG_DIR/${gen_token}.log" ]] && \
        mv "$LOG_DIR/${gen_token}.log" "$LOG_DIR/failed/" 2>/dev/null || true
}

# --- Log retention: bounded age + byte ceilings (Items 1,6) ---
_prune_log_dir() {
    local dir="$1" max_age="$2" max_bytes="$3"
    shift 3
    local -a excludes=("$@")
    local now cutoff total=0
    now=$(date +%s)
    cutoff=$((now - max_age))

    local -a kept_paths=() kept_sizes=()
    while IFS= read -r -d '' line; do
        local epoch rest size path bname skip=false
        epoch="${line%% *}"; rest="${line#* }"
        size="${rest%% *}"; path="${rest#* }"
        epoch="${epoch%%.*}"
        bname="${path##*/}"
        for exc in "${excludes[@]+"${excludes[@]}"}"; do
            [[ "$bname" = "$exc" ]] && { skip=true; break; }
        done
        $skip && continue
        if [[ "$epoch" -lt "$cutoff" ]]; then
            rm -f "$path"
        else
            kept_paths+=("$path")
            kept_sizes+=("$size")
            total=$((total + size))
        fi
    done < <(find "$dir" -maxdepth 1 -name '*.log' -printf '%T@ %s %p\0' 2>/dev/null | sort -z -n)

    if [[ "$total" -gt "$max_bytes" ]]; then
        local i
        for i in "${!kept_paths[@]}"; do
            [[ "$total" -le "$max_bytes" ]] && break
            rm -f "${kept_paths[$i]}"
            total=$((total - ${kept_sizes[$i]}))
        done
    fi
}

retire_logs() {
    local sup_log="$LOG_DIR/supervisor.log"
    if [[ -f "$sup_log" ]]; then
        local sup_size
        sup_size=$(stat -c%s "$sup_log" 2>/dev/null) || sup_size=0
        if [[ "$sup_size" -gt 2097152 ]]; then
            tail -c 1048576 "$sup_log" | tail -n +2 > "${sup_log}.tmp"
            cat "${sup_log}.tmp" > "$sup_log"
            rm -f "${sup_log}.tmp"
            exec 2>>"$sup_log"
            log "rotated supervisor.log (was ${sup_size} bytes)"
        fi
    fi

    local -a excludes=("supervisor.log")
    [[ -n "${CURRENT_GEN_TOKEN:-}" ]] && excludes+=("${CURRENT_GEN_TOKEN}.log")
    [[ -n "${NEXT_GEN_TOKEN:-}" ]] && excludes+=("${NEXT_GEN_TOKEN}.log")

    _prune_log_dir "$LOG_DIR" 259200 67108864 "${excludes[@]}"
    mkdir -p "$LOG_DIR/failed"
    _prune_log_dir "$LOG_DIR/failed" 604800 16777216
}

# --- Signal handling (critic #1): record signal and exit; cleanup on EXIT only ---
on_signal() {
    log "received $1 — shutting down"
    exit $(( 128 + $(kill -l "$1") ))
}
trap 'on_signal TERM' TERM
trap 'on_signal INT' INT

# --- Cleanup (idempotent, EXIT only — runs after on_signal's exit) ---
cleanup() {
    $CLEANED && return
    CLEANED=true
    log "cleaning up"
    [[ -n "$TIMER_PID" ]] && kill "$TIMER_PID" 2>/dev/null
    wait "$TIMER_PID" 2>/dev/null || true
    for pid in "$CURRENT_PID" "$NEXT_PID"; do
        [[ -n "$pid" ]] && kill_and_reap "$pid"
    done
    [[ -n "$CURRENT_GEN_TOKEN" ]] && cleanup_gen "$CURRENT_GEN_TOKEN"
    [[ -n "$NEXT_GEN_TOKEN" ]] && cleanup_gen "$NEXT_GEN_TOKEN"
    rm -f "$(sock_path 0)" "$(sock_path 1)"
}
trap cleanup EXIT

# --- Kill and reap: TERM → 5s → KILL → wait ---
kill_and_reap() {
    local pid="$1"
    [[ -z "$pid" ]] && return 0
    kill "$pid" 2>/dev/null || { wait "$pid" 2>/dev/null || true; return 0; }
    local dl=$((SECONDS + 5))
    while [[ $SECONDS -lt $dl ]] && kill -0 "$pid" 2>/dev/null; do sleep 0.25; done
    if kill -0 "$pid" 2>/dev/null; then
        log "force-killing $pid"
        kill -9 "$pid" 2>/dev/null
    fi
    wait "$pid" 2>/dev/null || true
}

# --- Merge mpv options ---
build_mpv_opts() {
    local slot="$1" start_pos="${2:-}"
    local parts
    parts="input-ipc-server=$(sock_path "$slot")"
    [[ -n "$start_pos" ]] && parts="$parts,start=+$start_pos"
    if [[ -n "$USER_MPV_OPTS" ]]; then
        local filtered
        filtered=$(printf '%s' "$USER_MPV_OPTS" | tr ',' '\n' \
            | grep -v -e '^input-ipc-server=' -e '^start=' || true)
        filtered=$(printf '%s' "$filtered" | tr '\n' ',' | sed 's/,$//')
        [[ -n "$filtered" ]] && parts="$parts,$filtered"
    fi
    printf '%s' "$parts"
}

# --- Launch (sets LAUNCHED_PID via $!, no command substitution) ---
LAUNCHED_PID=""
LAUNCH_READY_FILE=""
LAUNCH_GEN_TOKEN=""

launch() {
    local slot="$1" video="${2:-$DEFAULT_VIDEO}" start_pos="${3:-}"

    GENERATION=$((GENERATION + 1))
    local gen_token="gen-${GENERATION}-$$"
    local ready_file="$READY_DIR/ready-${gen_token}"
    local gen_log="$LOG_DIR/${gen_token}.log"

    rm -f "$ready_file" "$(sock_path "$slot")"

    local mpv_opts
    mpv_opts=$(build_mpv_opts "$slot" "$start_pos")

    local release_target_file="$READY_DIR/release-target-${gen_token}"
    rm -f "$release_target_file"

    MURALE_READY_FILE="$ready_file" \
    MURALE_GENERATION="$gen_token" \
    MURALE_RELEASE_TARGET_FILE="$release_target_file" \
        "$MURALE_BIN" "$video" "${MURALE_PASSTHROUGH[@]+"${MURALE_PASSTHROUGH[@]}"}" \
        --supervised \
        --mpv-options "$mpv_opts" \
        >> "$gen_log" 2>&1 &
    LAUNCHED_PID=$!
    LAUNCH_READY_FILE="$ready_file"
    LAUNCH_GEN_TOKEN="$gen_token"
    LAUNCH_RELEASE_TARGET_FILE="$release_target_file"
    log "launched slot=$slot pid=$LAUNCHED_PID gen=$gen_token video=$(basename "$video") log=$gen_log"
}

# --- Launch in hold-commit mode (B starts paused, invisible) ---
LAUNCH_HOLD_READY_FILE=""
LAUNCH_SWAP_DONE_FILE=""
LAUNCH_TARGET_RENDERED_FILE=""
LAUNCH_ARM_RENDER_FILE=""

launch_held() {
    local slot="$1" video="${2:-$DEFAULT_VIDEO}"

    GENERATION=$((GENERATION + 1))
    local gen_token="gen-${GENERATION}-$$"
    local ready_file="$READY_DIR/ready-${gen_token}"
    local hold_ready_file="$READY_DIR/hold-ready-${gen_token}"
    local swap_done_file="$READY_DIR/swap-done-${gen_token}"
    local target_rendered_file="$READY_DIR/target-rendered-${gen_token}"
    local arm_render_file="$READY_DIR/arm-render-${gen_token}"
    local gen_log="$LOG_DIR/${gen_token}.log"

    local release_target_file="$READY_DIR/release-target-${gen_token}"
    rm -f "$ready_file" "$hold_ready_file" "$swap_done_file" \
          "$target_rendered_file" "$arm_render_file" "$release_target_file" \
          "$(sock_path "$slot")"

    local mpv_opts
    mpv_opts=$(build_mpv_opts "$slot" "")
    mpv_opts="pause=yes,$mpv_opts"

    MURALE_READY_FILE="$ready_file" \
    MURALE_GENERATION="$gen_token" \
    MURALE_HOLD_COMMIT=1 \
    MURALE_HOLD_READY_FILE="$hold_ready_file" \
    MURALE_SWAP_DONE_FILE="$swap_done_file" \
    MURALE_TARGET_RENDERED_FILE="$target_rendered_file" \
    MURALE_ARM_RENDER_FILE="$arm_render_file" \
    MURALE_RELEASE_TARGET_FILE="$release_target_file" \
        "$MURALE_BIN" "$video" "${MURALE_PASSTHROUGH[@]+"${MURALE_PASSTHROUGH[@]}"}" \
        --supervised \
        --mpv-options "$mpv_opts" \
        >> "$gen_log" 2>&1 &
    LAUNCHED_PID=$!
    LAUNCH_READY_FILE="$ready_file"
    LAUNCH_GEN_TOKEN="$gen_token"
    LAUNCH_HOLD_READY_FILE="$hold_ready_file"
    LAUNCH_SWAP_DONE_FILE="$swap_done_file"
    LAUNCH_TARGET_RENDERED_FILE="$target_rendered_file"
    LAUNCH_ARM_RENDER_FILE="$arm_render_file"
    LAUNCH_RELEASE_TARGET_FILE="$release_target_file"
    log "launched-held slot=$slot pid=$LAUNCHED_PID gen=$gen_token video=$(basename "$video") log=$gen_log"
}

# --- Wait for hold readiness ---
wait_hold_ready() {
    local pid="$1" hold_ready_file="$2" gen_token="$3"
    local dl=$((SECONDS + OVERLAP_TIMEOUT))
    while [[ $SECONDS -lt $dl ]]; do
        if [[ -f "$hold_ready_file" ]]; then
            local content
            content=$(cat "$hold_ready_file" 2>/dev/null || echo "")
            if [[ "$content" = "HOLD_READY:${pid}:${gen_token}" ]] \
                && kill -0 "$pid" 2>/dev/null; then
                return 0
            fi
        fi
        kill -0 "$pid" 2>/dev/null || { log "pid $pid died before hold-ready"; return 1; }
        sleep 0.25
    done
    log "hold-ready timeout (${OVERLAP_TIMEOUT}s) for pid $pid"
    return 1
}

# --- Wait for swap-done artifact ---
wait_swap_done() {
    local pid="$1" swap_done_file="$2" gen_token="$3"
    local dl=$((SECONDS + 5))
    while [[ $SECONDS -lt $dl ]]; do
        if [[ -f "$swap_done_file" ]]; then
            local content
            content=$(cat "$swap_done_file" 2>/dev/null || echo "")
            if [[ "$content" = "${pid}:${gen_token}" ]]; then
                return 0
            fi
        fi
        kill -0 "$pid" 2>/dev/null || { log "pid $pid died before swap-done"; return 1; }
        sleep 0.01
    done
    log "swap-done timeout for pid $pid"
    return 1
}

# --- Wait for display readiness (compositor callback) ---
wait_display_ready() {
    local pid="$1" ready_file="$2" gen_token="$3"
    local dl=$((SECONDS + 5))
    while [[ $SECONDS -lt $dl ]]; do
        if [[ -f "$ready_file" ]]; then
            local content
            content=$(cat "$ready_file" 2>/dev/null || echo "")
            if [[ "$content" = "${pid}:${gen_token}" ]] \
                && kill -0 "$pid" 2>/dev/null; then
                return 0
            fi
        fi
        kill -0 "$pid" 2>/dev/null || { log "pid $pid died before display-ready"; return 1; }
        sleep 0.01
    done
    log "display-ready timeout for pid $pid"
    return 1
}

# --- Read TARGET_RENDERED artifact (sets TR_GEN and TR_POS) ---
TR_GEN=0
TR_POS=""

read_target_rendered() {
    local file="$1"
    [[ -f "$file" ]] || return 1
    local content
    content=$(cat "$file" 2>/dev/null || echo "")
    local gen pos
    gen="${content%%:*}"
    pos="${content#*:}"
    [[ "$gen" =~ ^[0-9]+$ ]] || return 1
    [[ -n "$pos" ]] || return 1
    TR_GEN="$gen"
    TR_POS="$pos"
    return 0
}

# --- IPC command with response validation ---
ipc_command() {
    local sock="$1" cmd_json="$2"
    local response
    response=$(printf '%s\n' "$cmd_json" \
        | timeout 2 socat - "UNIX-CONNECT:$sock" 2>/dev/null) || {
        log "IPC command failed (socket=$sock)"; return 1
    }
    local err
    err=$(printf '%s' "$response" | python3 -c '
import sys, json
d = json.load(sys.stdin)
print(d.get("error", "unknown"))
' 2>/dev/null) || {
        log "IPC response parse failed"; return 1
    }
    if [[ "$err" != "success" ]]; then
        log "IPC command error: $err"; return 1
    fi
    return 0
}

# --- Build workload key from IPC only (queries path internally) ---
build_workload_key_from_ipc() {
    local sock="$1"
    local bname width height codec fps hwdec mpv_ver vid_path
    vid_path=$(ipc_query "$sock" "path") || return 1
    bname=$(basename "$vid_path")
    width=$(ipc_query "$sock" "video-out-params/w") || width="unknown"
    height=$(ipc_query "$sock" "video-out-params/h") || height="unknown"
    codec=$(ipc_query "$sock" "video-codec") || codec="unknown"
    fps=$(ipc_query "$sock" "container-fps") || fps="unknown"
    hwdec=$(ipc_query "$sock" "hwdec-current") || hwdec="unknown"
    mpv_ver=$(ipc_query "$sock" "mpv-version") || mpv_ver="unknown"
    printf '%s|%sx%s|%s|%s|%s|%s' "$bname" "$width" "$height" "$codec" "$fps" "$hwdec" "$mpv_ver"
}

# --- Hidden sync: prepare target and release at rendezvous ---
RELEASE_MONO=""
ROUGH_SEEK_AHEAD="0.800"
DEFAULT_RELEASE_LATENCY="0.030"

get_calibrated_release_latency() {
    echo "$DEFAULT_RELEASE_LATENCY"
}

sync_prepare_and_release() {
    local sock_a="$1" sock_b="$2" b_pid="$3" duration="$4"
    local target_rendered_file="$5" arm_file="$6" gen_token="$7" a_release_file="${8:-}"

    # Phase 1: Wait for B's hwdec to resolve, then validate identity.
    local hwdec_dl=$((SECONDS + 5))
    while [[ $SECONDS -lt $hwdec_dl ]]; do
        local b_hwdec
        b_hwdec=$(ipc_query "$sock_b" "hwdec-current") || b_hwdec=""
        if [[ -n "$b_hwdec" ]] && [[ "$b_hwdec" != "no" ]]; then
            break
        fi
        kill -0 "$b_pid" 2>/dev/null || { log "B died waiting for hwdec"; return 1; }
        sleep 0.1
    done

    local key_a key_b
    key_a=$(build_workload_key_from_ipc "$sock_a") || return 1
    key_b=$(build_workload_key_from_ipc "$sock_b") || return 1
    if [[ "$key_a" != "$key_b" ]]; then
        log "A/B workload key mismatch: A=$key_a B=$key_b"; return 1
    fi

    # Derive position tolerance from FPS
    local b_fps frame_ms pos_threshold_ms
    b_fps=$(ipc_query "$sock_b" "container-fps") || { log "cannot query B fps"; return 1; }
    read -r frame_ms pos_threshold_ms < <(python3 -c '
import sys, math
fps, tol = float(sys.argv[1]), float(sys.argv[2])
if not (math.isfinite(fps) and fps > 0): sys.exit(1)
if not (math.isfinite(tol) and tol > 0): sys.exit(1)
fm = 1000.0 / fps
print(f"{fm:.6f} {fm * tol:.6f}")
' "$b_fps" "$POS_TOLERANCE_FRAMES") || { log "invalid fps=$b_fps or tolerance=$POS_TOLERANCE_FRAMES"; return 1; }

    # Phase 2: Snapshot pre-seek gen
    local pre_seek_gen=0
    if read_target_rendered "$target_rendered_file"; then
        pre_seek_gen=$TR_GEN
    fi

    # Phase 3: Rough seek — get B ahead of A's current position.
    # We don't need to predict where A will be. We just put B ~800ms ahead,
    # wait for the render, then measure the actual gap and time the release.
    local a_rough_pos
    a_rough_pos=$(ipc_query "$sock_a" "time-pos") || return 1

    local rough_target
    rough_target=$(python3 -c '
import sys
a, H, dur = float(sys.argv[1]), float(sys.argv[2]), float(sys.argv[3])
t = (a + H) % dur if dur > 0 else a + H
print(f"{t:.6f}")
' "$a_rough_pos" "$ROUGH_SEEK_AHEAD" "$duration") || return 1

    # Arm BEFORE seek (critic V4 #1)
    local arm_seq=$GENERATION
    printf '%s:%s' "$rough_target" "$arm_seq" > "$arm_file"

    local seek_json
    seek_json=$(python3 -c '
import json, sys
print(json.dumps({"command": ["seek", sys.argv[1], "absolute"]}))
' "$rough_target") || return 1
    ipc_command "$sock_b" "$seek_json" || return 1

    # Phase 4: Wait for TARGET_RENDERED (gen+pos match, bounded to 3s)
    local target_rendered_ok=false
    local render_dl=$((SECONDS + 3))
    TR_GEN=0; TR_POS=""
    while [[ $SECONDS -lt $render_dl ]]; do
        if read_target_rendered "$target_rendered_file"; then
            if [[ "$TR_GEN" -gt "$pre_seek_gen" ]]; then
                local pos_err_ms
                pos_err_ms=$(python3 -c '
import sys
r, t, d = float(sys.argv[1]), float(sys.argv[2]), float(sys.argv[3])
e = abs(r - t)
if d > 0 and e > d / 2: e = d - e
print(f"{e * 1000:.6f}")
' "$TR_POS" "$rough_target" "$duration") || { sleep 0.025; continue; }
                local pos_frames
                pos_frames=$(python3 -c 'import sys;print(f"{float(sys.argv[1])/float(sys.argv[2]):.2f}")' "$pos_err_ms" "$frame_ms")
                if python3 -c 'import sys;sys.exit(0 if float(sys.argv[1])<float(sys.argv[2]) else 1)' "$pos_err_ms" "$pos_threshold_ms" 2>/dev/null; then
                    log "target rendered: gen=$TR_GEN pos=$TR_POS pos_err=${pos_err_ms}ms (${pos_frames} frames)"
                    target_rendered_ok=true
                    break
                else
                    log "pos_err=${pos_err_ms}ms (${pos_frames} frames) > ${pos_threshold_ms}ms (${POS_TOLERANCE_FRAMES} frames)"
                    return 1
                fi
            fi
        fi
        kill -0 "$b_pid" 2>/dev/null || { log "B died during target render"; return 1; }
        sleep 0.025
    done

    if ! $target_rendered_ok; then
        log "target render not confirmed (3s timeout)"; return 1
    fi

    # Phase 5: B is rendered at TR_POS. NOW sample A precisely and compute
    # how far ahead B is. No prediction — direct measurement.
    local release_lat
    release_lat=$(get_calibrated_release_latency)

    local wait_secs
    wait_secs=$(python3 -c '
import sys, time
b_pos = float(sys.argv[1])
dur = float(sys.argv[2])
L = float(sys.argv[3])
sock_a = sys.argv[4]

import subprocess, json

def ipc_pos(sock):
    cmd = json.dumps({"command": ["get_property", "time-pos"]})
    r = subprocess.run(["socat", "-", "UNIX-CONNECT:" + sock],
                       input=(cmd + "\n").encode(), capture_output=True, timeout=3)
    d = json.loads(r.stdout.strip())
    if d.get("error") != "success": raise ValueError(d)
    return float(d["data"])

a1 = ipc_pos(sock_a)
a2 = ipc_pos(sock_a)
# Unwrap
if a1 - a2 > dur / 2: a2 += dur
elif a2 - a1 > dur / 2: a1 += dur
a_mid = ((a1 + a2) / 2) % dur if dur > 0 else (a1 + a2) / 2

# Circular forward distance from A to B
diff = (b_pos - a_mid) % dur if dur > 0 else b_pos - a_mid
if diff < 0: diff += dur

# A will reach B position in diff seconds. Release L before that.
wait = diff - L
if wait < 0.005: wait = 0.005  # floor at 5ms — never negative
print(f"{wait:.6f}")
' "$TR_POS" "$duration" "$release_lat" "$sock_a") || return 1

    log "measured: B=$TR_POS, wait=${wait_secs}s before release (L=${release_lat}s)"

    # Phase 6: Revalidate identity before release
    local key_a2 key_b2
    key_a2=$(build_workload_key_from_ipc "$sock_a") || return 1
    key_b2=$(build_workload_key_from_ipc "$sock_b") || return 1
    if [[ "$key_a2" != "$key_b2" ]] || [[ "$key_a2" != "$key_a" ]]; then
        log "identity changed during sync"; return 1
    fi

    # Phase 7: Sleep until A reaches B's position (minus release latency)
    python3 -c '
import time, sys
time.sleep(max(0, float(sys.argv[1])))
' "$wait_secs"

    # Phase 8: Release — VSync-aligned via A's frame callback, with direct fallback
    kill -0 "$b_pid" 2>/dev/null || { log "B died before release"; return 1; }
    local pre_release_mono
    pre_release_mono=$(python3 -c 'import time; print(f"{time.monotonic():.6f}")')

    local vsync_released=false
    if [[ -n "$a_release_file" ]]; then
        printf '%s' "$b_pid" > "$a_release_file"
        local release_dl=$((SECONDS + 1))
        while [[ $SECONDS -lt $release_dl ]]; do
            if [[ ! -f "$a_release_file" ]]; then
                vsync_released=true
                log "release via A's VSync callback"
                break
            fi
            sleep 0.004
        done
        if ! $vsync_released; then
            rm -f "$a_release_file"
            log "VSync release timeout — falling back to direct signal"
        fi
    fi

    if ! $vsync_released; then
        kill -USR2 "$b_pid" 2>/dev/null || { log "SIGUSR2 failed"; return 1; }
        log "release signal sent (direct)"
    fi

    RELEASE_MONO="$pre_release_mono"  # exported for caller's latency calibration
    export RELEASE_MONO
    return 0
}

# --- Wait for readiness: validate PID + generation token + liveness ---
wait_ready() {
    local pid="$1" ready_file="$2" gen_token="$3"
    local dl=$((SECONDS + OVERLAP_TIMEOUT))

    while [[ $SECONDS -lt $dl ]]; do
        if [[ -f "$ready_file" ]]; then
            local content
            content=$(cat "$ready_file" 2>/dev/null || echo "")
            if [[ "$content" = "${pid}:${gen_token}" ]]; then
                if kill -0 "$pid" 2>/dev/null; then
                    return 0
                else
                    log "pid $pid wrote ready but died"
                    return 1
                fi
            fi
        fi
        kill -0 "$pid" 2>/dev/null || { log "pid $pid died before ready"; return 1; }
        sleep 0.25
    done
    log "readiness timeout (${OVERLAP_TIMEOUT}s) for pid $pid"
    return 1
}

# --- IPC query ---
ipc_query() {
    local sock="$1" prop="$2"
    printf '{"command":["get_property","%s"]}\n' "$prop" \
        | timeout 2 socat - UNIX-CONNECT:"$sock" 2>/dev/null \
        | python3 -c "
import sys,json
d=json.load(sys.stdin)
assert d.get('error')=='success','ipc error: '+str(d.get('error'))
print(d['data'])" 2>/dev/null
}

# --- Atomic position sync: path₁ → time-pos → duration → path₂ ---
SYNC_PATH=""
SYNC_POS=""
SYNC_DUR=""

sync_position() {
    local sock="$1"
    local path1 pos dur path2
    local attempt
    for attempt in 1 2 3; do
        path1=$(ipc_query "$sock" "path") || { sleep 0.1; continue; }
        pos=$(ipc_query "$sock" "time-pos") || { sleep 0.1; continue; }
        dur=$(ipc_query "$sock" "duration") || { sleep 0.1; continue; }
        path2=$(ipc_query "$sock" "path") || { sleep 0.1; continue; }

        if [[ "$path1" = "$path2" ]] && [[ -n "$pos" ]] && [[ -n "$dur" ]]; then
            if python3 -c "
import math,sys
v=float(sys.argv[1]); d=float(sys.argv[2])
assert math.isfinite(v) and v>=0 and math.isfinite(d) and d>0
" "$pos" "$dur" 2>/dev/null; then
                SYNC_PATH="$path1"
                SYNC_POS="$pos"
                SYNC_DUR="$dur"
                return 0
            fi
        fi
        sleep 0.1
    done
    log "position sync failed after 3 attempts"
    return 1
}

# --- Resource gates (critic #4: fail-closed) ---
check_resources() {
    local mem_avail_kb
    mem_avail_kb=$(awk '/MemAvailable/ {print $2}' /proc/meminfo 2>/dev/null) || {
        log "cannot read /proc/meminfo"; return 1
    }
    if ! [[ "$mem_avail_kb" =~ ^[0-9]+$ ]]; then
        log "non-numeric MemAvailable: '$mem_avail_kb'"; return 1
    fi
    [[ "$mem_avail_kb" -lt 4194304 ]] && {
        log "insufficient memory: ${mem_avail_kb}kB (need 4GiB)"; return 1
    }

    local gpu_free
    gpu_free=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | head -1) || {
        log "nvidia-smi failed — skipping overlap"; return 1
    }
    if ! [[ "$gpu_free" =~ ^[0-9]+$ ]]; then
        log "nvidia-smi returned non-numeric VRAM: '$gpu_free'"; return 1
    fi
    [[ "$gpu_free" -lt 3072 ]] && {
        log "insufficient VRAM: ${gpu_free}MiB (need 3GiB)"; return 1
    }

    if journalctl -k --since '5 min ago' --no-pager -q 2>/dev/null | grep -qi 'oom.killer\|out.of.memory'; then
        log "recent kernel OOM detected — skipping overlap"; return 1
    fi

    # Tmpfs guard: ensure sufficient space for generation logs
    local tmpfs_avail_kb
    tmpfs_avail_kb=$(df --output=avail "$READY_DIR" 2>/dev/null | tail -1) || {
        log "cannot check tmpfs space"; return 1
    }
    tmpfs_avail_kb="${tmpfs_avail_kb// /}"
    if ! [[ "$tmpfs_avail_kb" =~ ^[0-9]+$ ]]; then
        log "non-numeric tmpfs avail: '$tmpfs_avail_kb'"; return 1
    fi
    if [[ "$tmpfs_avail_kb" -lt 51200 ]]; then
        log "insufficient tmpfs: ${tmpfs_avail_kb}kB (need 50MiB)"; return 1
    fi

    return 0
}

# --- Validate B's IPC path matches expected (critic #2: must be called) ---
validate_b_path() {
    local sock="$1" expected_path="$2"
    local b_path
    b_path=$(ipc_query "$sock" "path") || return 1
    [[ "$b_path" = "$expected_path" ]]
}

# --- Calibration: self-correcting startup delay estimation ---

compute_start_pos() {
    local a_pos="$1" cal_offset="$2" duration="$3"
    python3 -c '
import sys
pos, C, dur = float(sys.argv[1]), float(sys.argv[2]), float(sys.argv[3])
target = (pos + C) % dur if dur > 0 else pos + C
print(f"{target:.6f}")
' "$a_pos" "$cal_offset" "$duration" 2>/dev/null || echo "$a_pos"
}

build_workload_key() {
    local video_path="$1" sock="$2"
    local bname width height codec fps hwdec mpv_ver
    bname=$(basename "$video_path")
    width=$(ipc_query "$sock" "video-out-params/w") || width="unknown"
    height=$(ipc_query "$sock" "video-out-params/h") || height="unknown"
    codec=$(ipc_query "$sock" "video-codec") || codec="unknown"
    fps=$(ipc_query "$sock" "container-fps") || fps="unknown"
    hwdec=$(ipc_query "$sock" "hwdec-current") || hwdec="unknown"
    mpv_ver=$(ipc_query "$sock" "mpv-version") || mpv_ver="unknown"
    printf '%s|%sx%s|%s|%s|%s|%s' "$bname" "$width" "$height" "$codec" "$fps" "$hwdec" "$mpv_ver"
}

get_calibrated_offset() {
    local workload_key="$1"
    if [[ ! -f "$CAL_FILE" ]]; then
        echo "$DEFAULT_CALIBRATION_OFFSET"
        return
    fi
    python3 -c '
import json, sys, statistics
key = sys.argv[1]
cal_file = sys.argv[2]
default = sys.argv[3]
try:
    with open(cal_file) as f:
        data = json.load(f)
except (json.JSONDecodeError, IOError):
    print(default)
    sys.exit(0)
if data.get("version") != 1:
    print(default)
    sys.exit(0)
matching = [s for s in data.get("samples", [])
            if s.get("workload_key") == key
            and isinstance(s.get("estimated_L"), (int, float))
            and isinstance(s.get("applied_C"), (int, float))
            and isinstance(s.get("residual_r"), (int, float))]
if len(matching) < 3:
    print(default)
    sys.exit(0)
recent = matching[-10:]
delays = [s["estimated_L"] for s in recent if 0.5 < s["estimated_L"] < 5.0]
if len(delays) < 3:
    print(default)
    sys.exit(0)
print(f"{statistics.median(delays):.4f}")
' "$workload_key" "$CAL_FILE" "$DEFAULT_CALIBRATION_OFFSET" 2>/dev/null || echo "$DEFAULT_CALIBRATION_OFFSET"
}

measure_offset() {
    local sock_a="$1" sock_b="$2" duration="$3" applied_c="$4"
    python3 - "$sock_a" "$sock_b" "$duration" "$applied_c" << 'MEASURE_EOF'
import subprocess, json, time, statistics, sys

def ipc(sock, prop):
    cmd_json = json.dumps({"command": ["get_property", prop]})
    r = subprocess.run(
        ["socat", "-", "UNIX-CONNECT:" + sock],
        input=(cmd_json + "\n").encode(), capture_output=True, timeout=3
    )
    d = json.loads(r.stdout.strip())
    if d.get("error") != "success":
        raise ValueError(f"IPC error: {d}")
    v = d["data"]
    if not isinstance(v, (int, float)) or v < 0:
        raise ValueError(f"Invalid value: {v}")
    return float(v)

SA, SB = sys.argv[1], sys.argv[2]
dur = float(sys.argv[3])
C = float(sys.argv[4])

offsets = []
for i in range(7):
    try:
        t_a1 = time.monotonic()
        a1 = ipc(SA, "time-pos")
        t_b = time.monotonic()
        b = ipc(SB, "time-pos")
        t_b2 = time.monotonic()
        a2 = ipc(SA, "time-pos")
        t_a2 = time.monotonic()

        # Unwrap a2 relative to a1 before interpolation (loop-wrap)
        if a1 - a2 > dur / 2:
            a2 += dur
        elif a2 - a1 > dur / 2:
            continue  # A1/A2 bracket a boundary — discard sample

        # Interpolate A at B's query midpoint using monotonic timestamps
        b_mid_time = (t_b + t_b2) / 2.0
        frac = (b_mid_time - t_a1) / (t_a2 - t_a1) if t_a2 != t_a1 else 0.5
        a_interp = a1 + frac * (a2 - a1)
        a_interp = a_interp % dur

        # Signed circular residual
        raw = a_interp - b
        if abs(raw) > dur / 2:
            raw = raw - dur if raw > 0 else raw + dur

        offsets.append(raw)
    except Exception:
        pass
    time.sleep(0.05)

if len(offsets) < 3:
    print("ERROR: insufficient samples", file=sys.stderr)
    sys.exit(1)

median_r = statistics.median(offsets)
estimated_L = C + median_r
print(f"{median_r:.6f} {estimated_L:.6f}")
MEASURE_EOF
}

record_calibration() {
    local workload_key="$1" applied_c="$2" residual_r="$3" duration="$4" start_pos="$5"
    python3 -c '
import json, sys, os, tempfile, time

key = sys.argv[1]
C = float(sys.argv[2])
r = float(sys.argv[3])
dur = float(sys.argv[4])
pos = float(sys.argv[5])
cal_file = sys.argv[6]
holdout_threshold = float(sys.argv[7])

L = C + r
phase = (pos / dur) if dur > 0 else 0.0

if not (0.5 < L < 5.0):
    sys.exit(0)

try:
    with open(cal_file) as f:
        data = json.load(f)
    if data.get("version") != 1:
        data = {"version": 1, "samples": []}
except (FileNotFoundError, json.JSONDecodeError):
    data = {"version": 1, "samples": []}

data["samples"].append({
    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "workload_key": key,
    "applied_C": round(C, 4),
    "residual_r": round(r, 4),
    "estimated_L": round(L, 4),
    "video_duration": round(dur, 3),
    "seek_phase": round(phase, 3),
})

data["samples"] = data["samples"][-100:]

matching = [s for s in data["samples"] if s.get("workload_key") == key]
count = len(matching)
if count > 3 and count % 3 == 0:
    if abs(r) > holdout_threshold:
        print(f"HOLDOUT_WARN: residual {r:.4f}s exceeds threshold {holdout_threshold}s (sample #{count})")

fd, tmp = tempfile.mkstemp(dir=os.path.dirname(cal_file))
try:
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.rename(tmp, cal_file)
except BaseException:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
' "$workload_key" "$applied_c" "$residual_r" "$duration" "$start_pos" "$CAL_FILE" "$HOLDOUT_THRESHOLD" 2>/dev/null
}

# --- Recovery: bounded loop (critic #5: fix off-by-one) ---
recover() {
    local attempt
    for attempt in $(seq 1 "$MAX_CONSECUTIVE_FAILURES"); do
        CONSECUTIVE_FAILURES=$((CONSECUTIVE_FAILURES + 1))
        local backoff=$(( 1 << (CONSECUTIVE_FAILURES > 5 ? 5 : CONSECUTIVE_FAILURES) ))
        [[ "$backoff" -gt 30 ]] && backoff=30
        log "recovery attempt $attempt/$MAX_CONSECUTIVE_FAILURES, backoff ${backoff}s"
        sleep "$backoff"

        launch $CURRENT_SLOT
        CURRENT_PID=$LAUNCHED_PID
        CURRENT_READY_FILE="$LAUNCH_READY_FILE"
        CURRENT_GEN_TOKEN="$LAUNCH_GEN_TOKEN"
        CURRENT_RELEASE_TARGET_FILE="$LAUNCH_RELEASE_TARGET_FILE"

        if wait_ready "$CURRENT_PID" "$CURRENT_READY_FILE" "$CURRENT_GEN_TOKEN"; then
            log "recovery successful (pid=$CURRENT_PID)"
            return 0
        fi
        kill_and_reap "$CURRENT_PID"
        fail_gen "$CURRENT_GEN_TOKEN"
        CURRENT_PID=""
    done
    log "recovery exhausted ($MAX_CONSECUTIVE_FAILURES attempts) — exiting"
    exit 1
}

# ===================== MAIN =====================

# Startup log retention
retire_logs

# Initial launch
launch $CURRENT_SLOT
CURRENT_PID=$LAUNCHED_PID
CURRENT_READY_FILE="$LAUNCH_READY_FILE"
CURRENT_GEN_TOKEN="$LAUNCH_GEN_TOKEN"
CURRENT_RELEASE_TARGET_FILE="$LAUNCH_RELEASE_TARGET_FILE"

if ! wait_ready "$CURRENT_PID" "$CURRENT_READY_FILE" "$CURRENT_GEN_TOKEN"; then
    log "initial launch failed"
    kill_and_reap "$CURRENT_PID"
    exit 1
fi
log "initial instance running (pid=$CURRENT_PID)"

# Event loop
while true; do
    sleep "$REFRESH_INTERVAL" &
    TIMER_PID=$!

    wait -n "$TIMER_PID" "$CURRENT_PID" 2>/dev/null || true

    timer_alive=true; kill -0 "$TIMER_PID" 2>/dev/null || timer_alive=false
    current_alive=true; kill -0 "$CURRENT_PID" 2>/dev/null || current_alive=false

    # Always clean up timer
    $timer_alive && kill "$TIMER_PID" 2>/dev/null
    wait "$TIMER_PID" 2>/dev/null || true
    TIMER_PID=""

    # --- A died during sleep ---
    if ! $current_alive; then
        log "current process $CURRENT_PID died — entering recovery"
        wait "$CURRENT_PID" 2>/dev/null || true
        fail_gen "$CURRENT_GEN_TOKEN"
        CURRENT_PID=""
        recover
        continue
    fi

    # --- Timer expired — attempt handoff ---
    CONSECUTIVE_FAILURES=0

    if ! check_resources; then
        log "skipping handoff — resource gate failed"
        continue
    fi

    # Sync position for path + duration
    SYNC_PATH=""; SYNC_POS=""; SYNC_DUR=""
    if ! sync_position "$(sock_path $CURRENT_SLOT)"; then
        log "position sync failed — skipping handoff"
        continue
    fi
    log "sync: path=$(basename "$SYNC_PATH") pos=$SYNC_POS dur=$SYNC_DUR"

    # --- Hidden sync handoff ---

    # Launch B in held mode (paused, invisible — no compositor commit)
    NEXT_SLOT=$(( (CURRENT_SLOT + 1) % 2 ))
    launch_held $NEXT_SLOT "$SYNC_PATH"
    NEXT_PID=$LAUNCHED_PID
    NEXT_READY_FILE="$LAUNCH_READY_FILE"
    NEXT_GEN_TOKEN="$LAUNCH_GEN_TOKEN"
    NEXT_RELEASE_TARGET_FILE="$LAUNCH_RELEASE_TARGET_FILE"

    # Wait for HOLD_READY (B paused, EGL configured, initial frame rendered into back buffer)
    if ! wait_hold_ready "$NEXT_PID" "$LAUNCH_HOLD_READY_FILE" "$LAUNCH_GEN_TOKEN"; then
        log "B failed to reach hold-ready"
        kill_and_reap "$NEXT_PID"
        fail_gen "$NEXT_GEN_TOKEN"
        NEXT_PID=""
        continue
    fi
    log "B ($NEXT_PID) hold-ready"

    # Prepare target and release at monotonic rendezvous
    if ! sync_prepare_and_release \
        "$(sock_path $CURRENT_SLOT)" "$(sock_path $NEXT_SLOT)" \
        "$NEXT_PID" "$SYNC_DUR" \
        "$LAUNCH_TARGET_RENDERED_FILE" "$LAUNCH_ARM_RENDER_FILE" "$LAUNCH_GEN_TOKEN" \
        "$CURRENT_RELEASE_TARGET_FILE"; then
        log "sync/release failed — keeping A"
        kill_and_reap "$NEXT_PID"
        fail_gen "$NEXT_GEN_TOKEN"
        NEXT_PID=""
        continue
    fi

    # Wait for SWAP_DONE (buffer submitted to compositor)
    if ! wait_swap_done "$NEXT_PID" "$LAUNCH_SWAP_DONE_FILE" "$LAUNCH_GEN_TOKEN"; then
        log "swap-done timeout — B may be stuck"
        kill_and_reap "$NEXT_PID"
        fail_gen "$NEXT_GEN_TOKEN"
        NEXT_PID=""
        continue
    fi
    log "B swap confirmed"

    # Unpause B only after swap confirmed
    if ! ipc_command "$(sock_path $NEXT_SLOT)" '{"command":["set_property","pause",false]}'; then
        log "unpause failed"
        kill_and_reap "$NEXT_PID"
        fail_gen "$NEXT_GEN_TOKEN"
        NEXT_PID=""
        continue
    fi
    log "B unpaused"

    # Wait for DISPLAY_READY (compositor callback — health confirmation)
    if ! wait_display_ready "$NEXT_PID" "$NEXT_READY_FILE" "$NEXT_GEN_TOKEN"; then
        log "display-ready timeout — B may be frozen visible"
        kill_and_reap "$NEXT_PID"
        fail_gen "$NEXT_GEN_TOKEN"
        NEXT_PID=""
        continue
    fi
    log "B display-ready confirmed"

    # --- Stabilization: keep A alive, watch B ---
    stable_dl=$((SECONDS + HEALTH_WINDOW))
    b_stable=true
    while [[ $SECONDS -lt $stable_dl ]]; do
        if ! kill -0 "$NEXT_PID" 2>/dev/null; then
            log "B died during stabilization — keeping A"
            fail_gen "$NEXT_GEN_TOKEN"
            b_stable=false; break
        fi
        if ! check_resources; then
            log "resource pressure during stabilization — aborting handoff"
            kill_and_reap "$NEXT_PID"
            fail_gen "$NEXT_GEN_TOKEN"
            b_stable=false; break
        fi
        sleep 1
    done

    if ! $b_stable; then
        wait "$NEXT_PID" 2>/dev/null || true
        NEXT_PID=""
        if kill -0 "$CURRENT_PID" 2>/dev/null; then
            log "A ($CURRENT_PID) still alive — continuing"
            continue
        else
            log "both A and B dead — recovery"
            wait "$CURRENT_PID" 2>/dev/null || true
            fail_gen "$CURRENT_GEN_TOKEN"
            CURRENT_PID=""
            recover
            continue
        fi
    fi

    # Final B liveness + path validation before retiring A
    if ! kill -0 "$NEXT_PID" 2>/dev/null; then
        log "B died after stabilization — keeping A"
        wait "$NEXT_PID" 2>/dev/null || true
        fail_gen "$NEXT_GEN_TOKEN"
        NEXT_PID=""
        continue
    fi

    desired_path="$SYNC_PATH"
    if kill -0 "$CURRENT_PID" 2>/dev/null; then
        fresh_a_path=$(ipc_query "$(sock_path $CURRENT_SLOT)" "path") || true
        [[ -n "${fresh_a_path:-}" ]] && desired_path="$fresh_a_path"
    fi
    if ! validate_b_path "$(sock_path $NEXT_SLOT)" "$desired_path"; then
        log "B path mismatch — discarding B, keeping A"
        kill_and_reap "$NEXT_PID"
        fail_gen "$NEXT_GEN_TOKEN"
        NEXT_PID=""
        continue
    fi

    # Retire A
    if kill -0 "$CURRENT_PID" 2>/dev/null; then
        log "retiring A ($CURRENT_PID)"
        kill_and_reap "$CURRENT_PID"
    else
        wait "$CURRENT_PID" 2>/dev/null || true
    fi

    # Final B liveness check after A retirement
    if ! kill -0 "$NEXT_PID" 2>/dev/null; then
        log "B died after A retirement — recovery"
        wait "$NEXT_PID" 2>/dev/null || true
        fail_gen "$NEXT_GEN_TOKEN"
        cleanup_gen "$CURRENT_GEN_TOKEN"
        CURRENT_PID=""
        NEXT_PID=""
        recover
        continue
    fi

    old_gen="$CURRENT_GEN_TOKEN"
    CURRENT_PID=$NEXT_PID
    CURRENT_SLOT=$NEXT_SLOT
    CURRENT_READY_FILE="$NEXT_READY_FILE"
    CURRENT_GEN_TOKEN="$NEXT_GEN_TOKEN"
    CURRENT_RELEASE_TARGET_FILE="$NEXT_RELEASE_TARGET_FILE"
    NEXT_PID=""
    cleanup_gen "$old_gen"
    retire_logs
    log "handoff complete: pid=$CURRENT_PID slot=$CURRENT_SLOT"
done
